# Copiar para .env (ignorado pelo git) · copy to .env (git-ignored)
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-dev-this-is-not-a-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Porta 5432 ocupada? · port busy? → "5433:5432" no compose.yaml e :5433 aqui · and :5433 here
DATABASE_URL=postgres://dwfa:dwfa@localhost:5432/dwfa
# Origens que podem chamar a API a partir de um browser (a SPA Vue da Aula 05).
# Várias? Separa por vírgulas, sem espaços: http://localhost:5173,https://loja.example
CORS_ALLOWED_ORIGINS=http://localhost:5173