# Copiar para .env (ignorado pelo git) · copy to .env (git-ignored):  cp .env.example .env
# O mesmo .env serve o desenvolvimento (runserver + compose.yaml) e o
# docker compose -f compose.prod.yaml up (que força settings.prod e o DATABASE_URL do contentor).

# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.dev
# Valor de demonstração. Numa produção a sério gera outro e guarda-o fora do git:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=dev-only-8Kq2vX7pLm4Rt9Wz3Nc6Hy1Bd5Fg0Js-change-me-for-real-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Porta 5432 ocupada? · port busy? → "5433:5432" no compose.yaml e :5433 aqui · and :5433 here
DATABASE_URL=postgres://dwfa:dwfa@localhost:5432/dwfa
# Origens que podem chamar a API a partir de um browser (a SPA em dev, no Vite).
# Várias? Separa por vírgulas, sem espaços: http://localhost:5173,https://loja.example
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Ficha 06: em dev os logs saem como texto; descomenta para ver uma linha de JSON por pedido.
# (Em produção, no compose.prod.yaml, o JSON já é o valor por omissão.)
# LOG_JSON=true

# ---- compose.prod.yaml (M2) ----
# HTTPS: True por omissão em settings.prod. O compose local é HTTP simples → False.
DJANGO_HTTPS=False
# A base de dados do contentor db (só existe dentro da rede do compose).
POSTGRES_DB=drivenow
POSTGRES_USER=drivenow
POSTGRES_PASSWORD=drivenow-local-only
# Porta do Nginx no teu computador: http://localhost (ou http://localhost:8080 com 8080).
WEB_PORT=80
# ---- Emails das entregas (M2, extra do Diogo · opcional) ----
# Sem estas linhas, os emails ao cliente vão para a consola (docker compose … logs backend).
# Num deploy a sério, descomentar e preencher: o EMAIL_BACKEND passa a ser SMTP.
# DEFAULT_FROM_EMAIL="DriveNow <entregas@drivenow.example>"
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
